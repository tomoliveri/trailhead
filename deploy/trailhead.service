# systemd unit (adjust User and paths). Put nginx (deploy/nginx.conf) in front for TLS.
[Unit]
Description=Trailhead
After=network-online.target

[Service]
User=trailhead
WorkingDirectory=/opt/trailhead
Environment=PORT=3041
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/trailhead/.venv/bin/python server.py
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
